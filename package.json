{
  "name": "@reticentrahul/recipe-planner",
  "version": "1.0.2",
  "private": false,
  "description": "Stencil web components for recipe planner (cards, lists, forms, meal planner)",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "import": "./loader/index.js",
      "types": "./loader/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "stencil build",
    "clean": "rimraf dist www",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stencil",
    "web-components",
    "recipes",
    "recipe-planner"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@stencil/core": "^4.0.0",
    "rimraf": "^3.0.0"
  }
}
