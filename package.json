{
  "name": "@reticentrahul/recipe-planner",
  "version": "1.0.6",
  "private": false,
  "description": "Stencil web components for recipe planner (cards, lists, forms, meal planner)",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./meal-planner": {
      "types": "./dist/components/meal-planner.d.ts",
      "import": "./dist/components/meal-planner.js"
    },
    "./recipe-list": {
      "types": "./dist/components/recipe-list.d.ts",
      "import": "./dist/components/recipe-list.js"
    },
    "./recipe-card": {
      "types": "./dist/components/recipe-card.d.ts",
      "import": "./dist/components/recipe-card.js"
    },
    "./recipe-detail": {
      "types": "./dist/components/recipe-detail.d.ts",
      "import": "./dist/components/recipe-detail.js"
    },
    "./recipe-form": {
      "types": "./dist/components/recipe-form.d.ts",
      "import": "./dist/components/recipe-form.js"
    },
    "./app-modal": {
      "types": "./dist/components/app-modal.d.ts",
      "import": "./dist/components/app-modal.js"
    }
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "stencil build",
    "clean": "rimraf dist www",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "prepublishOnly": "npm run build",
    "generate": "stencil generate"
  },
  "keywords": [
    "stencil",
    "web-components",
    "recipes",
    "recipe-planner"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@stencil/core": "^4.0.0",
    "rimraf": "^3.0.0",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  }
}
